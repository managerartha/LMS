# LMS Artha Safety Indonesia — pengaturan server (Hostinger)

# Wajib HTTPS: kamera dan GPS di browser hanya berjalan di HTTPS.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Folder kode, data privat, dan pustaka tidak boleh dibuka dari browser.
RewriteRule ^(app|storage|vendor)(/|$) - [F,L]
RewriteRule ^(composer\.(json|lock)|\.user\.ini)$ - [F,L]

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
  <FilesMatch "(index\.html|config\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|webp|jpg|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
