# LMS Artha Safety Indonesia — pengaturan Apache (cPanel)

# Wajib HTTPS: kamera dan GPS di browser hanya berjalan di HTTPS.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Jangan tampilkan daftar isi folder.
Options -Indexes

<IfModule mod_headers.c>
  # Halaman utama & config selalu dicek ulang agar pembaruan langsung terasa.
  <FilesMatch "(index\.html|config\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Gambar, CSS, JS lain boleh disimpan browser (versi diatur lewat ?v= di index.html).
  <FilesMatch "\.(css|js|png|webp|jpg|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
